# LLM / embeddings provider 
# This starter uses  for both embeddings and chat completion.
# Swap providers by editing backend
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# Retrieval tuning
TOP_K=5
SIMILARITY_THRESHOLD=0.25

# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database
SQLITE_PATH=./data/lore.db

# Scraping from backend
SCRAPE_DELAY_MS=1500
SCRAPE_USER_AGENT=sonic-lore-rag-bot/1.0 (educational project)

# Frontend
VITE_API_BASE_URL=http://localhost:3001
